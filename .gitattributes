# Enforce Unix (LF) line endings in the repository
* text=auto eol=lf

# C / kernel sources
*.c text eol=lf
*.h text eol=lf
*.patch text eol=lf

# Build / project files
Makefile text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.in text eol=lf

# Scripts and config
*.sh text eol=lf
*.py text eol=lf
*.lua text eol=lf
*.pl text eol=lf
*.m4 text eol=lf
*.ac text eol=lf
*.am text eol=lf

# Docs and metadata
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

# Shell-style init snippets
contrib/** text eol=lf
cmake/** text eol=lf

# Binary assets (do not line-end normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
